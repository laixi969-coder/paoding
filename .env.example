PAODING_DATABASE_URL=postgresql+psycopg://paoding:paoding@127.0.0.1:5432/paoding
PAODING_DATA_DIR=./data
PAODING_VAULT_DIR=./PaoDing_Vault
PAODING_DROP_DIR=./PaoDing_Drop
PAODING_MODELS_FILE=./config/models.yaml
# API stays on localhost. Set a long token before binding to other interfaces.
PAODING_API_TOKEN=
PAODING_HOST=127.0.0.1
PAODING_PORT=8010
PAODING_TIMEZONE=Asia/Shanghai
# Production never synthesizes demo model output.
PAODING_DEMO_MODE=false
DEEPSEEK_API_KEY=
QWEN_API_KEY=
DOUBAO_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Generic collector bridge, see docs/integrations.md
PAODING_COLLECTOR_URL=
PAODING_COLLECTOR_TOKEN=
PAODING_TELEGRAM_SECRET=
PAODING_TELEGRAM_BOT_TOKEN=
PAODING_FEISHU_VERIFICATION_TOKEN=
# Optional OpenAI-compatible embedding model; must produce exactly 1536 dimensions.
PAODING_EMBEDDING_PROVIDER=
PAODING_EMBEDDING_MODEL=

# Native platform collection (collector bridge above remains an optional override)
PAODING_TIKHUB_TOKEN=
PAODING_TIKHUB_BASE_URL=https://api.tikhub.io
PAODING_COOKIES_FILE=
PAODING_COLLECTOR_MAX_PAGES=20
PAODING_FEEDS_FILE=./config/feeds.yaml
PAODING_RSSHUB_URL=
PAODING_WEWE_RSS_URL=
PAODING_WORKBUDDY_DIR=

# local / jina / firecrawl
PAODING_WEBPAGE_READER=local
PAODING_JINA_TOKEN=
PAODING_FIRECRAWL_TOKEN=
PAODING_FIRECRAWL_URL=https://api.firecrawl.dev/v1

# auto = cloud when token configured, otherwise basic PDF text extraction.
# local uses the separately installed `mineru` executable; cloud needs a token.
PAODING_MINERU_MODE=auto
PAODING_MINERU_TOKEN=
PAODING_MINERU_URL=https://mineru.net/api/v4
PAODING_MINERU_COMMAND=mineru

# Native video processing and optional speech transcription
PAODING_FFMPEG_COMMAND=ffmpeg
PAODING_FFPROBE_COMMAND=ffprobe
PAODING_VIDEO_SEGMENT_SECONDS=120
PAODING_MAX_DOWNLOAD_BYTES=268435456
PAODING_TRANSCRIPTION_PROVIDER=
PAODING_TRANSCRIPTION_MODEL=

# Feishu custom app: message receive, image/file resources and bot send permissions
PAODING_FEISHU_APP_ID=
PAODING_FEISHU_APP_SECRET=
PAODING_FEISHU_ENCRYPT_KEY=

# WeCom self-built application
PAODING_WECOM_CORP_ID=
PAODING_WECOM_AGENT_ID=0
PAODING_WECOM_CORP_SECRET=
PAODING_WECOM_TOKEN=
PAODING_WECOM_ENCODING_AES_KEY=
PAODING_TAXONOMY_MIN_SOURCES=20
